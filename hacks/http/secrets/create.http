# Um objeto ou uma lista (até 50). Types: string, password, url, database_uri, api_key, jwt_key, paseto_key.
POST {{APPLICATION_BACKEND}}/api/v1/applications/{{APP_ID}}/members/me/secrets
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
    "name": "DATABASE_URL",
    "type": "database_uri",
    "value": "postgres://app:senha@db.internal:5432/app"
}
