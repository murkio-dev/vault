# Aponta para um segredo estático da mesma aplicação e do mesmo tipo.
POST {{APPLICATION_BACKEND}}/api/v1/applications/{{APP_ID}}/members/me/secrets
Authorization: Bearer {{ACCESS_TOKEN}}
Content-Type: application/json

{
    "name": "DB_ALIAS",
    "type": "database_uri",
    "source": "reference",
    "reference_secret_id": "{{SECRET_ID}}"
}
