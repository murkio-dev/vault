# Server
APPLICATION_PORT=8083
APPLICATION_BACKEND=http://localhost:8083
GRPC_PORT=50052

# Identity
# gRPC interno do identity (só loopback): de lá vem o JWKS
IDENTITY_GRPC_ADDR=127.0.0.1:50051
AUTH_APPLICATION_ID=

# Storage (relativo = a partir da pasta do binário)
SQLITE_PATH=vault.db
LOG_PATH=vault.log

# Encryption
ENCRYPTION_KEY=
ENCRYPTION_KEYS_PREVIOUS=

