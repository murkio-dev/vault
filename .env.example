# API
ENVIRONMENT=dev
SERVER_PORT=:8083
# gRPC interno: escuta só em 127.0.0.1, fora do Caddy. Credencial: token do SDK (vt_...).
GRPC_PORT=50052

# Banco e log: relativos à pasta do binário (no `go run`, à pasta atual), de onde
# quer que o serviço seja iniciado. O .env também é lido dali e da pasta atual; o
# que já está no ambiente do processo vale mais que o arquivo.
SQLITE_PATH=vault.db
# Vazio: <nome do binário>.log ao lado dele (vault-api.log).
LOG_PATH=

# Auth: de onde vêm as chaves que validam o JWT das pessoas. A aplicação é a do
# Vault dentro do Auth; o Vault só confia nela. https://; http:// só em localhost.
AUTH_URL=http://localhost:8080
AUTH_APPLICATION_ID=

# Cifragem dos segredos em repouso: 32 bytes em base64, obrigatória
# (openssl rand -base64 32). A chave nunca fica no banco nem vai para o git.
ENCRYPTION_KEY=
# Chaves antigas da rotação, separadas por vírgula. Vazia: nenhuma.
ENCRYPTION_KEYS_PREVIOUS=

# URL pública do Vault (opcional): a URI do SDK é <PUBLIC_URL>/<uri_id>
PUBLIC_URL=
